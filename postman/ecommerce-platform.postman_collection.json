{
  "info": {
    "_postman_id": "a1b2c3d4-0001-0001-0001-000000000001",
    "name": "ScentHub E-commerce Platform",
    "description": "Complete API collection for ScentHub AI-powered E-commerce & Logistics Platform.\n\nImport this collection with the Local environment file (local.postman_environment.json).\n\nRun Collection top-to-bottom to test the full flow end-to-end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Order Service",
      "description": "Order Service endpoints (port 8081)",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('lastOrderId', json.orderId);",
                  "    console.log('Saved lastOrderId: ' + json.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n  \"items\": [\n    { \"productId\": \"b2c3d4e5-0000-0000-0000-000000000002\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orderServiceUrl}}/orders",
              "host": ["{{orderServiceUrl}}"],
              "path": ["orders"]
            },
            "description": "Creates a new order. Saves orderId to {{lastOrderId}} for chained requests."
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{orderServiceUrl}}/orders/{{lastOrderId}}",
              "host": ["{{orderServiceUrl}}"],
              "path": ["orders", "{{lastOrderId}}"]
            },
            "description": "Get a single order by ID"
          }
        },
        {
          "name": "Get Orders by Customer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{orderServiceUrl}}/orders?customerId=a1b2c3d4-0000-0000-0000-000000000001",
              "host": ["{{orderServiceUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "customerId", "value": "a1b2c3d4-0000-0000-0000-000000000001" }
              ]
            },
            "description": "Get all orders for a specific customer"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{orderServiceUrl}}/orders/{{lastOrderId}}/cancel",
              "host": ["{{orderServiceUrl}}"],
              "path": ["orders", "{{lastOrderId}}", "cancel"]
            },
            "description": "Cancel an order. Returns 409 if shipment is already dispatched."
          }
        },
        {
          "name": "Agent - Product Consult",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Do you have any wireless headphones under $100?\"\n}"
            },
            "url": {
              "raw": "{{orderServiceUrl}}/agents/product-consult",
              "host": ["{{orderServiceUrl}}"],
              "path": ["agents", "product-consult"]
            },
            "description": "AI agent for product consultation — searches real inventory and answers customer questions."
          }
        },
        {
          "name": "Agent - Cancel Support",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I want to cancel my order {{lastOrderId}}\"\n}"
            },
            "url": {
              "raw": "{{orderServiceUrl}}/agents/cancel-support",
              "host": ["{{orderServiceUrl}}"],
              "path": ["agents", "cancel-support"]
            },
            "description": "AI agent for order cancellation support."
          }
        }
      ]
    },
    {
      "name": "Product & Inventory Service",
      "description": "Inventory Service endpoints (port 8082)",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('lastProductId', json.productId);",
                  "    console.log('Saved lastProductId: ' + json.productId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Noise-cancelling over-ear headphones\",\n  \"price\": 79.99,\n  \"stockQuantity\": 50\n}"
            },
            "url": {
              "raw": "{{inventoryServiceUrl}}/products",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["products"]
            },
            "description": "Create a new product. Saves productId to {{lastProductId}}."
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 89.99,\n  \"stockQuantity\": 45\n}"
            },
            "url": {
              "raw": "{{inventoryServiceUrl}}/products/{{lastProductId}}",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["products", "{{lastProductId}}"]
            },
            "description": "Update product details (partial update — only provided fields are changed)."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{inventoryServiceUrl}}/products/{{lastProductId}}",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["products", "{{lastProductId}}"]
            },
            "description": "Delete a product by ID. Returns 204 No Content."
          }
        },
        {
          "name": "List/Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{inventoryServiceUrl}}/products?search=",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "", "description": "Optional keyword to filter by name (case-insensitive)" }
              ]
            },
            "description": "List all products. Pass ?search=keyword to filter by name."
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{inventoryServiceUrl}}/products/{{lastProductId}}",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["products", "{{lastProductId}}"]
            },
            "description": "Get a single product by ID"
          }
        },
        {
          "name": "Low Stock Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{inventoryServiceUrl}}/analytics/low-stock?threshold=10",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["analytics", "low-stock"],
              "query": [
                { "key": "threshold", "value": "10", "description": "Default is 10" }
              ]
            },
            "description": "Get products where available stock (stockQuantity - reservedQuantity) is below threshold."
          }
        },
        {
          "name": "Revenue Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{inventoryServiceUrl}}/analytics/revenue",
              "host": ["{{inventoryServiceUrl}}"],
              "path": ["analytics", "revenue"]
            },
            "description": "Get the total revenue from all OrderCreatedEvents processed via Kafka Streams."
          }
        }
      ]
    },
    {
      "name": "Shipping Service",
      "description": "Shipping Service endpoints (port 8083) — Member 3 Task 3.1",
      "item": [
        {
          "name": "Get Shipment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{shippingServiceUrl}}/shipments/{{lastOrderId}}",
              "host": ["{{shippingServiceUrl}}"],
              "path": ["shipments", "{{lastOrderId}}"]
            },
            "description": "Get shipment status for an order. Returns 404 if no shipment exists yet (expected — order not confirmed yet)."
          }
        },
        {
          "name": "Update Shipment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISPATCHED\"\n}"
            },
            "url": {
              "raw": "{{shippingServiceUrl}}/shipments/{{lastOrderId}}/status",
              "host": ["{{shippingServiceUrl}}"],
              "path": ["shipments", "{{lastOrderId}}", "status"]
            },
            "description": "Manually update a shipment's status. Valid values: CREATED, DISPATCHED, IN_TRANSIT, DELIVERED, CANCELLED. Returns 400 for invalid status."
          }
        }
      ]
    },
    {
      "name": "Customer Service",
      "description": "Customer Service endpoints (port 8084) — Member 3 Tasks 3.3 & 3.4",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('lastCustomerId', json.customerId);",
                  "    console.log('Saved lastCustomerId: ' + json.customerId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\"\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers"]
            },
            "description": "Create a new customer. Email must be unique. Saves customerId to {{lastCustomerId}}."
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{lastCustomerId}}",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers", "{{lastCustomerId}}"]
            },
            "description": "Get a customer by ID. Returns 404 if not found."
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\"\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{lastCustomerId}}",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers", "{{lastCustomerId}}"]
            },
            "description": "Update customer fields (partial update — only provided fields are changed)."
          }
        },
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great product! Very fast delivery.\",\n  \"rating\": 5\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{lastCustomerId}}/feedback",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers", "{{lastCustomerId}}", "feedback"]
            },
            "description": "Submit feedback for a customer. Rating is optional (1-5 recommended). Returns 404 if customer not found."
          }
        },
        {
          "name": "Submit Complaint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('lastComplaintId', json.complaintId);",
                  "    console.log('Saved lastComplaintId: ' + json.complaintId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"My order arrived damaged. Requesting a replacement.\"\n}"
            },
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{lastCustomerId}}/complaints",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers", "{{lastCustomerId}}", "complaints"]
            },
            "description": "Submit a complaint. Initially set to status=OPEN. Returns 201 with complaint details."
          }
        },
        {
          "name": "Get Complaints",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{customerServiceUrl}}/customers/{{lastCustomerId}}/complaints",
              "host": ["{{customerServiceUrl}}"],
              "path": ["customers", "{{lastCustomerId}}", "complaints"]
            },
            "description": "Get all complaints for a customer. Returns empty array if none, not an error."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "orderServiceUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "inventoryServiceUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "shippingServiceUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "customerServiceUrl",
      "value": "http://localhost:8084"
    }
  ]
}
